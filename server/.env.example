# MySQL (db/schema.sql 을 먼저 실행해 today_case DB를 만들어 두세요)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=today_case

# 용의자 대사를 만들 AI. 키를 하나도 안 넣으면 알리바이 문장으로 답하는 모의 모드로 돌아갑니다.
# Groq (무료 티어): https://console.groq.com/keys 에서 키 발급
GROQ_API_KEY=
# Claude (유료). GROQ_API_KEY가 비어 있을 때만 쓰입니다.
ANTHROPIC_API_KEY=

# 선택: groq | claude | mock. 비워두면 키가 있는 쪽(Groq 우선)을 씁니다.
LLM_PROVIDER=
# 선택: 비워두면 groq=openai/gpt-oss-120b, claude=claude-haiku-5-5
LLM_MODEL=

PORT=3001
