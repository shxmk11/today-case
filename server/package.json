{
  "name": "today-case-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "scenarios": "node --env-file-if-exists=.env --import tsx src/scenarios.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "express": "^5.3.0",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.7",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
